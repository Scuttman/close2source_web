{
  "name": "close2source",
  "private": true,
  "version": "0.1.0",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier -w .",
    "zip": "next build && zip -r deploy.zip server.js package.json package-lock.json next.config.js public .next --exclude '.next/cache/*' && echo 'Created deploy.zip'",
    "deploy": "npm run zip && node scripts/ftp-deploy.js"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@types/nodemailer": "^7.0.11",
    "firebase": "^10.14.1",
    "jsonrepair": "^3.13.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "next": "^15.5.2",
    "nodemailer": "^8.0.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.21",
    "basic-ftp": "^5.2.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.9.0",
    "eslint-config-next": "^15.5.2",
    "firebase-tools": "^14.15.2",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
